# Secrets — never commit these
.env
.env.*
*secret*
*_key*
*api_key*
config.local.*

# ...but template/example files ARE meant to be committed (they document required
# vars without real values) — exempt anything ending .example from the patterns above
!*.example
!.env.example

# Eval service runtime data (recreated locally; not meant to be version-controlled)
eval-service/eval_results.db
eval-service/*.db
eval-service/__pycache__/
eval-service/*.pyc
eval-service/.venv/
eval-service/venv/

# OS / editor cruft
.DS_Store
Thumbs.db
*.swp
.vscode/
.idea/

# n8n local runtime (not the exported workflow JSON, which IS committed)
n8n/.n8n/
