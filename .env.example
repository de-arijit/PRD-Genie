# OpenAI (primary LLM tier, IK-provided key)
OPENAI_API_KEY=

# Ollama (local fallback tiers: qwen3.5:4b first fallback, mistral:7b-instruct second fallback)
# n8n runs inside Docker Desktop, so it cannot reach the host machine via "localhost" — use
# host.docker.internal instead, which Docker resolves to the host. Note: on this machine
# "localhost:11434" from the Windows host itself is also unreliable (it can resolve to a
# different, unrelated Ollama instance over IPv6) — use http://127.0.0.1:11434 explicitly for
# any host-side script, and http://host.docker.internal:11434 from anything running in Docker
# (both verified to reach the correct model catalog).
OLLAMA_HOST=http://host.docker.internal:11434

# Langfuse (observability/tracing)
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=

# Eval service (see eval-service/README.md and eval-service/main.py's API_KEY)
EVAL_SERVICE_API_KEY=
EVAL_SERVICE_URL=
